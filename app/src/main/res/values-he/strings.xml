<resources>
    <string name="app_name">LED Strip Controller</string>

    <!-- Permissions -->
    <string name="perm_rationale">LED Strip Controller זקוק להרשאות Bluetooth ומיקרופון כדי לסרוק אחר רצועת ה-LED שלך ולאפשר סנכרון מוזיקה.</string>
    <string name="btn_grant_permissions">מתן הרשאות</string>
    <string name="bt_disabled_msg">Bluetooth כבוי. יש להפעיל אותו כדי להתחבר לרצועת ה-LED שלך.</string>
    <string name="btn_enable_bluetooth">הפעלת Bluetooth</string>
    <string name="ble_unsupported_msg">מכשיר זה אינו תומך ב-Bluetooth Low Energy, שבו LED Strip Controller משתמש כדי לתקשר עם רצועת ה-LED שלך, ולכן האפליקציה לא יכולה לפעול כאן.\n\nאם רכשת את האפליקציה ב-Google Play, ניתן לבקש החזר כספי מהיסטוריית ההזמנות שלך ב-Play Store.</string>
    <string name="ble_unverified_msg">מכשיר זה אינו מדווח על תמיכה ב-Bluetooth Low Energy, ולכן איננו יכולים להבטיח ש-LED Strip Controller יעבוד עם רצועת ה-LED שלך.\n\nניתן לנסות בכל זאת. אם האפליקציה לא מצליחה למצוא את הרצועה או להתחבר אליה, ניתן לבקש החזר כספי מהיסטוריית ההזמנות שלך ב-Play Store.</string>
    <string name="btn_continue_anyway">לנסות בכל זאת</string>
    <string name="btn_close_app">סגירה</string>

