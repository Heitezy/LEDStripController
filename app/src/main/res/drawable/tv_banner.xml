<?xml version="1.0" encoding="utf-8"?>
<!-- TV launcher banner — 320×180 dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/ic_launcher_background_start"
                android:endColor="@color/ic_launcher_background_end"
                android:type="linear" />
        </shape>
    </item>

    <item android:gravity="center">
        <vector
            xmlns:aapt="http://schemas.android.com/aapt"
            android:width="320dp"
            android:height="180dp"
            android:viewportWidth="320"
            android:viewportHeight="180">
            <group
                android:scaleX="4.0"
                android:scaleY="4.0"
                android:pivotX="12"
                android:pivotY="12"
                android:translateX="148"
                android:translateY="78">

                <!-- Phone Outline with Sweep Gradient -->
                <path android:pathData="M28.5,19.5L28.5,4.5c0,-1.1 -0.9,-2 -2,-2L-2.5,2.5c-1.1,0 -2,0.9 -2,2l0,15c0,1.1 0.9,2 2,2L26.5,21.5c1.1,0 2,-0.9 2,-2zM-2.5,19.5L-2.5,4.5L26.5,4.5l0,15L-2.5,19.5z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="sweep"
                            android:centerX="12"
                            android:centerY="12">
                            <item android:color="#FF0000" android:offset="0.0" />
                            <item android:color="#FFFF00" android:offset="0.17" />
                            <item android:color="#00FF00" android:offset="0.33" />
                            <item android:color="#00FFFF" android:offset="0.50" />
                            <item android:color="#0000FF" android:offset="0.67" />
                            <item android:color="#FF00FF" android:offset="0.83" />
                            <item android:color="#FF0000" android:offset="1.0" />
                        </gradient>
                    </aapt:attr>
                </path>

                <!-- Solid Flat-Bottom Bulb Head -->
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M12,6.625c-2.21,0 -4,1.79 -4,4c0,1.29 0.61,2.44 1.56,3.16h4.88c0.95,-0.72 1.56,-1.87 1.56,-3.16c0,-2.21 -1.79,-4 -4,-4z" />

                <!-- Wide Middle Strip -->
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M9.78,14.275h4.44v0.89h-4.44z" />

                <!-- Tapered Bottom Cap -->
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M10.04,15.7h3.92l-0.62,0.71c-0.2,0.37 -0.6,0.62 -1.02,0.62h-0.62c-0.42,0 -0.82,-0.25 -1.02,-0.62z" />

            </group>
        </vector>
    </item>
</layer-list>