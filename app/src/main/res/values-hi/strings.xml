    <string name="desc_screen_sync">20 fps पर आपकी स्क्रीन के प्रमुख रंग को LED पर वास्तविक समय में सिंक करता है। चमकीली और रंगीन सामग्री सबसे अच्छा काम करती है।</string>
    <string name="label_dominant_color">प्रमुख रंग</string>
